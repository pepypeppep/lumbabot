# Lumba WhatsApp Bot Configuration

# Base directory where projects are located
# For server: /home/zsn/code
PROJECTS_BASE_DIR=/home/zsn/code

# OpenCode model to run
OPENCODE_MODEL=deepseek/deepseek-v4-flash

# Path to opencode executable (leave as 'opencode' if in PATH)
OPENCODE_PATH=opencode

# OpenCode execution flags (--auto is YOLO mode for automated approvals)
OPENCODE_FLAGS=--auto

# Bot trigger name
BOT_NAME=lumba

# Git sync settings
AUTO_PULL=true
AUTO_PUSH=true

# Optional security filters (leave empty to allow all group members)
# Comma-separated list of WhatsApp numbers (e.g. 628123456789,628987654321)
ALLOWED_NUMBERS=

# WhatsApp session folder name
AUTH_SESSION_DIR=auth_info_baileys
